# Copy to .env.local and use an existing PostgreSQL database.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/lestari

# Required only for Lesbot.
GEMINI_API_KEY=

# Optional Google OAuth web client. Set the exact callback URL when configuring Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LESTARI_AUTH_ORIGIN=http://localhost:3000
